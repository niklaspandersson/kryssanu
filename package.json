{
  "name": "kryssanu",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"vite\" \"php -S localhost:3001 -t packages/server-php/public packages/server-php/public/app.php\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run test:db:provision && playwright test",
    "test:e2e:ui": "npm run test:db:provision && playwright test --ui",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:provision": "tsx e2e/provision.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:build-birds-csv": "tsx tools/data-import/build-birds-csv.ts",
    "db:import-birds": "tsx tools/data-import/import-sverigelistan.ts",
    "db:migrate-bird-ids": "tsx tools/data-import/migrate-bird-ids.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@solidjs/router": "^0.14.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.56.0",
    "concurrently": "^9.0.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-solid": "^2.10.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
