{
  "name": "kryssanu",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"pnpm --filter @kryssanu/client dev\" \"pnpm --filter @kryssanu/server dev\"",
    "build": "pnpm --filter @kryssanu/client build && pnpm --filter @kryssanu/server build",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  }
}
