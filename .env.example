# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/kryssanu"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App URL (used for OAuth redirect URIs)
APP_URL="http://localhost:5173"

# Vite (client)
VITE_GOOGLE_CLIENT_ID=""

# Directory for user-uploaded observation images (absolute path recommended).
# Defaults to packages/server-php/user-images when unset.
IMAGE_UPLOAD_DIR=""

# Public "hero image" on bird detail pages, sourced from user uploads.
# Off by default until image moderation/auditing is in place.
PUBLIC_BIRD_IMAGES_ENABLED=""
