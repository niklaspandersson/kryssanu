generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// A taxon from Sverigelistan, BirdLife Sveriges official Swedish bird list.
/// Species and subspecies are both rows; a subspecies points at its species
/// through parentId. See tools/data-import/import-sverigelistan.ts.
model Bird {
  id           String  @id // latin name
  swedish      String
  english      String?
  family       String // swedish family name, e.g. "änder"
  // Defaulted so `prisma db push` can add them to a Bird table that already has
  // rows; the seed fills them in for every listed taxon. Only birds that have
  // dropped off Sverigelistan keep the empty value.
  familyLatin  String  @default("")
  orderLatin   String  @default("")
  orderSwedish String  @default("")

  /// The species a subspecies belongs to; null on species rows. A bird with a
  /// parent is a subspecies — there is no separate rank field.
  parentId   String?
  parent     Bird?   @relation("BirdSubspecies", fields: [parentId], references: [id])
  /// Populated on species rows that have subspecies listed.
  subspecies Bird[]  @relation("BirdSubspecies")

  /// Fyndkategori A-E, per AERC definitions. Always set for a listed taxon: the
  /// import rolls the value up from subspecies, or down from the species, for
  /// the rows the spreadsheet leaves blank. The empty default is only so
  /// `prisma db push` can add the column to a populated table, and only a
  /// delisted bird keeps it — the API reports empty as null.
  kategori String  @default("")
  /// H = häckfågel, h = oklar/oregelbunden häckning, F = flyttfågel,
  /// T = tillfällig, R = raritet (<100 fynd), I = introduktion.
  ///
  /// I is ours rather than Raritetskommittén's: it assigns kategori E taxa no
  /// Swedish status at all. Empty default as for kategori.
  ///
  /// H and h differ only in case, and MySQL's default utf8mb4_unicode_ci makes
  /// them the same value to compare against — `WHERE status = 'h'` would match
  /// all 445 breeders instead of the 3 irregular ones. Prisma cannot express a
  /// column collation, so after `prisma db push` on a fresh database run:
  ///
  ///   ALTER TABLE `Bird` MODIFY `status`
  ///     VARCHAR(191) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin NOT NULL DEFAULT '';
  status   String  @default("")
  extinct  Boolean @default(false)

  /// No longer on Sverigelistan. Kept so existing observations stay intact,
  /// but not offered when logging new ones.
  delisted Boolean @default(false)

  observations Observation[]

  @@index([parentId])
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  image         String?
  googleId      String?       @unique
  city          String?
  about         String?       @db.Text
  /// Serialized user preferences. Shape and defaults live in src/lib/settings.ts.
  /// Deliberately schemaless so adding a setting needs no migration.
  settings      Json?
  sessions      Session[]
  observations  Observation[]
  createdEvents Event[]       @relation("EventCreator")
  participants  Participant[]
  lists         List[]
  googleToken   GoogleToken?
}

model GoogleToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String   @db.VarChar(512)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  oauthState String?  @db.VarChar(64)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // bin/cleanup-sessions.php runs `DELETE FROM Session WHERE expiresAt < NOW()`
  // nightly; the table grows with users × logins.
  @@index([expiresAt])
}

model Observation {
  id        String             @id @default(cuid())
  date      DateTime           @default(now())
  location  String?
  latitude  Float?
  longitude Float?
  note      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  birdId    String
  userId    String
  bird      Bird               @relation(fields: [birdId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  events    ObservationEvent[]
  lists     ObservationList[]
  images    ObservationImage[]

  // Every observation list is `WHERE userId = ? ORDER BY date DESC LIMIT n`.
  // A bare userId index carries no date, so MySQL reads all of a user's rows
  // and filesorts them for every page — LIMIT does not bound the work. The
  // trailing id also matches `ORDER BY date DESC, id DESC` exactly.
  @@index([userId, date, id])
  // Serves the checklist's per-species aggregate, COUNT(DISTINCT birdId), and
  // the birdId-filtered observation pages, all covering.
  @@index([userId, birdId, date])
  @@index([birdId])
}

model ObservationImage {
  id            String      @id @default(cuid())
  observationId String
  width         Int? // of the large variant
  height        Int?
  createdAt     DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  // The thumbnail lookup is `WHERE observationId = ? ORDER BY createdAt ASC
  // LIMIT 1`, run once per observation row in every list query. The bare
  // createdAt index it replaces served no query in the codebase.
  @@index([observationId, createdAt])
}

model Event {
  id                String             @id @default(cuid())
  name              String
  description       String?
  isPublic          Boolean            @default(false)
  startsAt          DateTime
  endsAt            DateTime
  createdAt         DateTime           @default(now())
  creatorId         String
  creator           User               @relation("EventCreator", fields: [creatorId], references: [id])
  participants      Participant[]
  observationEvents ObservationEvent[]
  inviteTokens      InviteToken[]

  @@index([creatorId])
  // `ORDER BY startsAt DESC` on the event browse, and the active-window filter
  // `startsAt <= NOW() AND endsAt >= NOW()` behind the feed, both full-scan
  // Event today.
  @@index([startsAt])
}

model ObservationEvent {
  observationId String
  eventId       String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([observationId, eventId])
  @@index([eventId])
  @@index([observationId])
}

model Participant {
  id       String   @id @default(cuid())
  userId   String
  eventId  String
  status   String   @default("INVITED") // INVITED | ACCEPTED | DECLINED
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model List {
  id           String            @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime          @default(now())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations ObservationList[]

  @@index([userId])
}

model ObservationList {
  observationId String
  listId        String
  addedAt       DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  list          List        @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([observationId, listId])
  @@index([listId])
  @@index([observationId])
}

model InviteToken {
  id         String    @id @default(cuid())
  token      String    @unique
  eventId    String
  createdAt  DateTime  @default(now())
  validUntil DateTime?
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}
