generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Bird {
  id           String        @id // latin name
  swedish      String
  family       String
  visitor      Boolean
  observations Observation[]
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  image         String?
  googleId      String?       @unique
  city          String?
  about         String?       @db.Text
  sessions      Session[]
  observations  Observation[]
  createdEvents Event[]       @relation("EventCreator")
  participants  Participant[]
  lists         List[]
  googleToken   GoogleToken?
}

model GoogleToken {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiresAt    DateTime
  scope        String   @db.VarChar(512)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  oauthState String?  @db.VarChar(64)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Observation {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  location  String?
  latitude  Float?
  longitude Float?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  birdId    String
  userId    String
  bird      Bird     @relation(fields: [birdId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  events    ObservationEvent[]
  lists     ObservationList[]
  images    ObservationImage[]

  @@index([userId])
  @@index([birdId])
}

model ObservationImage {
  id            String      @id @default(cuid())
  observationId String
  width         Int? // of the large variant
  height        Int?
  createdAt     DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
  @@index([createdAt])
}

model Event {
  id           String        @id @default(cuid())
  name         String
  description  String?
  isPublic     Boolean       @default(false)
  startsAt     DateTime
  endsAt       DateTime
  createdAt    DateTime      @default(now())
  creatorId    String
  creator      User          @relation("EventCreator", fields: [creatorId], references: [id])
  participants      Participant[]
  observationEvents ObservationEvent[]
  inviteTokens      InviteToken[]

  @@index([creatorId])
}

model ObservationEvent {
  observationId String
  eventId       String
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([observationId, eventId])
  @@index([eventId])
  @@index([observationId])
}

model Participant {
  id       String            @id @default(cuid())
  userId   String
  eventId  String
  status   String            @default("INVITED") // INVITED | ACCEPTED | DECLINED
  joinedAt DateTime          @default(now())
  user     User              @relation(fields: [userId], references: [id])
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model List {
  id           String            @id @default(cuid())
  name         String
  description  String?
  createdAt    DateTime          @default(now())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  observations ObservationList[]

  @@index([userId])
}

model ObservationList {
  observationId String
  listId        String
  addedAt       DateTime    @default(now())
  observation   Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  list          List        @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([observationId, listId])
  @@index([listId])
  @@index([observationId])
}

model InviteToken {
  id         String    @id @default(cuid())
  token      String    @unique
  eventId    String
  createdAt  DateTime  @default(now())
  validUntil DateTime?
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

