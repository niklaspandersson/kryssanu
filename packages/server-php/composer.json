{
  "name": "kryssanu/server",
  "description": "Kryssanu API server",
  "require": {
    "php": ">=8.2",
    "ext-gd": "*",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.7",
    "google/apiclient": "^2.0",
    "vlucas/phpdotenv": "^5.6",
    "visus/cuid2": "^4.0",
    "intervention/image": "^3.0"
  },
  "scripts": {
    "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
  },
  "extra": {
    "google/apiclient-services": [
      "Oauth2",
      "Sheets"
    ]
  },
  "autoload": {
    "psr-4": {
      "Kryssanu\\": "src/"
    }
  }
}
